{
  "name": "rm-fm/azuracast-sweepers",
  "description": "Intro-aware jingle overlays for AzuraCast.",
  "type": "azuracast-plugin",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "RM-FM"
    }
  ],
  "require": {
    "php": "^8.4"
  },
  "autoload": {
    "psr-4": {
      "Plugin\\AzuracastSweepers\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "php tests/run.php",
      "php tests/navigation.php"
    ]
  },
  "require-dev": {
    "guzzlehttp/psr7": "^2.7",
    "psr/http-server-middleware": "^1.0",
    "slevomat/coding-standard": "^8.24",
    "squizlabs/php_codesniffer": "^4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
